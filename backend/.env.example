PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=

# JSON Web Token
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Angular frontend URL (used in email links)
CLIENT_URL=http://localhost:4200

# Resend email service (https://resend.com — free 3,000 emails/month)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# From: use onboarding@resend.dev for testing, or your verified domain
EMAIL_FROM=Mind Care Portal <onboarding@resend.dev>
